{
  "name": "@personal-md/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-fonts": "cp ../brand/fonts/*.woff2 public/fonts/",
    "predev": "npm run sync-fonts",
    "prebuild": "npm run sync-fonts",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "node --test test/*.test.ts",
    "preview": "vite --config vite.preview.config.ts"
  },
  "dependencies": {
    "@personal-md/brand": "*",
    "@personal-md/core": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@wxt-dev/module-react": "^1.1.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "wxt": "^0.20.0"
  }
}
