{
  "compilerOptions": {
    "target": "ES2023",
    // WebWorker rather than DOM: this package runs in the landing, in an MV3
    // service worker and under node --test, and it needs WebCrypto's types
    // without gaining a `document` it must never touch.
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
